# ============================================================
# chan.py 交易网关配置 .env（2026-09-09 实测修正版）
# 复制为仓库根目录 .env：  cp .env C:\my_chan_project\.env
#
# ⚠️ 重要（实测确认，勿删）：本文件只放 TRADING_ 前缀键！
#   Trading/Config.py 的 TradingConfig 是 BaseSettings + extra="forbid"，
#   读 .env 时遇到任何非 TRADING_ 前缀键（HOST/PORT/TDX_INSTALL_DIR/
#   SN_ACCOUNT/LIVE_ACCOUNT/TQ_ACCOUNT 等裸键）会直接抛 extra_forbidden，
#   网关子进程（Trading/main.py、AppTrader._load_cfg）启动即崩。
#   · App 层（App/AppConfig.py extra="ignore"）的 HOST/PORT/TDX_INSTALL_DIR
#     不设也有默认值（Windows TDX 默认 D:\new_tdx_hd_test，与你实际目录一致），
#     需要覆盖时请用【系统环境变量】，不要写进这个文件。
#   · 凭据（SN_ACCOUNT/SN_PASSWORD/TQ_ACCOUNT/TQ_PASSWORD/LIVE_ACCOUNT/
#     LIVE_PASSWORD）由 SimNow.py 走 os.environ.get 直读，.env 里的裸键
#     既读不到、又会触发上面的崩溃 —— 凭据只放【系统环境变量】。
# ============================================================

# ── 通道选择与「登录方式」弹框（2026-09-28 改造）──────────────────
#   现在切链路**不用改这个文件**：开启页面「自动下单」开关 → 弹「登录方式」框
#   选 SimNow / 实盘 → 后端以环境变量注入子进程（优先级高于 .env），
#   选项持久化在 state.db，下次默认仍是上次选的那条。
#   本行只作为**非界面路径**（CLI 直跑 / 不带 link 的调用）的默认值，
#   保留 simnow 是刻意选的安全侧默认：即使绕过界面也不会直接进实盘。
TRADING_BROKER=simnow

# ── 实盘（创元期货）────────────────────────────────────────────
#   这两行是「界面上实盘选项能不能选」的前置 —— 缺任一，实盘选项置灰，
#   悬停会写明缺哪一项（不再像以前那样启动后才被闸门拦下一句看不懂的话）：
#     tq_market            = 资金账户所属期货公司名，必须与实盘资金账户一致
#     confirm_live_trading = 实盘资格总开关（防"以为在仿真、其实在实盘"）
TRADING_BROKER_PARAMS__TQ_MARKET=创元期货
TRADING_BROKER_PARAMS__CONFIRM_LIVE_TRADING=true
# 实盘凭据（系统环境变量，勿写本文件）：
#   LIVE_ACCOUNT=<创元 CTP 资金账号>  LIVE_PASSWORD=<CTP 密码>
#   TQ_ACCOUNT=<天勤账号>             TQ_PASSWORD=<天勤密码>
#   （缺任一 → SimNow.py fail-fast，拒绝启动）
#
# ⚠️ 改完本文件必须重启后端服务才生效 —— .env 只在 TradingConfig 加载时读一次。
