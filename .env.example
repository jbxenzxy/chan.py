# ============================================================
# chan.py 配置模板（阶段 2 · V10 方案 7.1/7.2）
# 复制为仓库根目录 .env 后按需修改；.env 已在 .gitignore 中，凭据不进 git
#   cp .env.example .env
# 优先级：环境变量 > .env > 代码默认值（默认值与历史硬编码一致，零配置可跑）
# ============================================================

# ── 基础设施配置（App/AppConfig.py 读取）─────────────────────────────
# API 服务监听地址与端口
HOST=127.0.0.1
PORT=18081

# 通达信安装目录（vipdoc/hq_cache 等路径由此推导；改目录只改这一处）
TDX_INSTALL_DIR=C:\new_tdx_hd_test

# chan.py 仓库根目录（默认自动取本仓库根，一般无需修改）
# CHAN_PATH=C:\my_chan_project

# 阶段 7 ProcessPool worker 数（0=自动按 CPU 核数适配；>0 显式覆盖）
# SCAN_POOL_WORKERS=10

# ── 天勤凭据（App/AppConfig.py 读取；方案 7.3：不落缓存/不写日志）────
# 读取优先级：环境变量 TQ_ACCOUNT/TQ_PASSWORD > {TDX_INSTALL_DIR}\vipdoc\tq_account.json
# 环境变量优先（win11 可直接 `setx TQ_ACCOUNT ...` 无需本地文件）；文件缺失时兜底
# TQ_ACCOUNT=
# TQ_PASSWORD=

# ── 算法参数与默认代码（ChanConfig.py 读取；未设置 = 引擎默认）────────
# 默认分析代码（原 my_chan_main.py 的 SYMBOL_CODE；标准格式 market(小写)+code）
# SYMBOL_CODE=sh000001

# 笔/段/中枢算法参数（完整清单见 ChanConfig.py _ENV_KEYS；示例）
# BI_STRICT=true
# SEG_ALGO=chan
# ZS_ALGO=over_seg
# TRIGGER_STEP=true
# MEAN_METRICS=5,13,29
# TREND_METRICS=[60,250]

# ── 同花顺工具链（Script/ths_*.py 读取）────────────────────────────
# 工具链脚本已随阶段 2 P2-2 迁入 Script/（原 App/ths_*.py 路径已过期）。
# Cookie 直配（留空则读 Script/ths_captured_cookie.txt，或运行 Script/ths_capture_cookie.py 生成）
# THS_COOKIE=

# ── 扫描/分析参数（App/AppConfig.py 读取；默认值与代码一致，可按需覆盖）────
# 扫描预过滤流通市值下限（亿）
# SCAN_MIN_FLOAT_MC=50.0
# 放量扫描比较窗口K线根数（A 往前数 N 根，A > 窗口内任一天成交额视为放量命中）
# SCAN_FANGLIANG_WINDOW_BARS=120
# 前端视口默认显示的K线根数（所有周期相同；经 /api/health 下发前端）
# VIEW_COUNT=233
# 双窗下窗「对齐不足降全量」阈值（下窗截断后不足此数→降全量）
# DUAL_SUB_FALLBACK_MIN=100
# 双窗口结构化缓存键上限（1组=2键；与单窗口共用 LRU 池但单独限额）
# MAX_DUAL_CACHE_KEYS=10
# 双窗运行时下窗 CChan 缓存条目上限
# MAX_STOCKS_SUB_CHAN=5
# 股票/期货 K 线回看条数（JSON，数组自动转 tuple；键为周期，值为 [bars, 说明]）
# STOCKS_LOOKBACK_CONFIG='{"w": [0, "不限制"], "d": [472, "24年09月10日"], "30m": [500, "近3个月"], "5m": [1000, "近1个月"]}'
# FUTURES_LOOKBACK_CONFIG='{"30m": [120, "15个交易日"], "5m": [240, "5个交易日"], "1m": [480, "2个交易日"], "15s": [960, "1个交易日"]}'
# SSE 推送详细调试日志开关（true/false）
# SSE_DEBUG=false
# 冷启动起始/结束日期（None=不开启；仅调试用）
# DEBUG_COLD_START_START_DATE=
# DEBUG_COLD_START_END_DATE=
# 前复权开关（true/false）
# FORWARD_ADJUST_ENABLED=true
# 全量数据模式（true/false）
# FULL_DATA_MODE=false
